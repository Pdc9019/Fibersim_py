{
  "meta": {
    "name": "GNPy validation run (copy)",
    "reference": "Derived from examples/configs/gnpy_val_1.json",
    "notes": "Use this config to compare FiberSim results against a GNPy-style validation (OSNR / ASE noise / post-DSP SNR). Do a run and record OSNR_final_dB and SNR_sym_dB for comparison."
  },
  "global": {
    "Rb": 3.2e10,
    "M": 4,
    "sps": 32,
    "Fs": 1.024e12,
    "Nsym": 4096,
    "Ptx": 1e-4,
    "mod": "QPSK",
    "rx": "coh",
    "pol": "sp"
  },
  "pulse": { "type": "RRC", "roll": 0.1, "span": 10 },
  "chain": [
    { "type": "edfa",  "par": { "G_dB": 22.0, "nsp": 1.58, "label": "booster" } },
    { "type": "fiber", "par": { "L": 80000.0, "beta2": -2.1e-26, "gamma": 0.0013, "dz": 10.0, "alpha": 4.605e-5, "label": "SMF 80 km" } },
    { "type": "edfa",  "par": { "G_dB": 16.0, "nsp": 1.70, "label": "preamp" } }
  ]
}